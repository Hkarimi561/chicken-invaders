# Copy to .env.local for local development. On Vercel, set these in Project Settings -> Environment Variables.

# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Leave empty in local development to use a JSON file (data/dev-db.json) instead of Postgres.
DATABASE_URL=

# Signs login cookies and game-server tokens. At least 24 random characters; the same value must be set on the
# website and on the game server. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Online rooms (optional): the public address of the game server (game-server/), e.g. https://cb-game.fly.dev
# Leave empty on a deployment without a game server: solo play, daily, boss rush, shop and leaderboards still work.
GAME_SERVER_URL=http://localhost:3001

# Game server only
PORT=3001
# The website's address; the game server only accepts browsers coming from it (empty = any origin, local use only)
ALLOWED_ORIGIN=

# Optional: force a seasonal event (halloween, christmas, valentine, nowruz) for testing
# EVENT_OVERRIDE=halloween
