{
  "name": "chicken-blasters",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,game \"next dev\" \"tsx --env-file-if-exists=.env.local game-server/index.ts\"",
    "dev:web": "next dev",
    "dev:game": "tsx --env-file-if-exists=.env.local game-server/index.ts",
    "build": "next build",
    "start": "next start",
    "start:game": "tsx game-server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-all.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "icons": "tsx scripts/make-icons.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.1.3",
    "next": "^16.1.1",
    "pg": "^8.16.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "@types/pg": "^8.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.5.9",
    "concurrently": "^8.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
